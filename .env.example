# Supabase project values: Project Settings -> API.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
# Supabase Postgres connection string: Project Settings -> Database -> Connection string.
DATABASE_URL=postgresql://postgres:your-url-encoded-password@db.your-project-ref.supabase.co:5432/postgres?sslmode=require

# Must match a redirect URL allowed in Supabase Authentication -> URL Configuration.
APP_URL=http://localhost:3000

# Set a unique random secret in every deployed environment.
AUTH_SECRET=replace-with-a-long-random-value

# Optional future provider configuration. No live payment/lending integration
# is enabled by these placeholders; never commit real credentials.
PAYMENT_PROVIDER=
PAYMENT_PUBLIC_KEY=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
LENDING_PARTNER=
LENDING_PARTNER_API_KEY=
